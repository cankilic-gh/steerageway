{
  "name": "steerageway",
  "version": "1.0.0",
  "private": true,
  "description": "Steerageway: a browser-based small-boat handling game with a real seamanship core (recreational education, not certification).",
  "keywords": [
    "boating",
    "seamanship",
    "simulator",
    "game",
    "three.js",
    "webgl",
    "vite",
    "typescript"
  ],
  "homepage": "https://steerageway.thegridbase.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cankilic-gh/steerageway.git"
  },
  "bugs": {
    "url": "https://github.com/cankilic-gh/steerageway/issues"
  },
  "license": "MIT",
  "author": "Can Kilic",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run e2e",
    "e2e:ci": "playwright test --grep @ci-smoke",
    "asset:boat": "sh tools/blender/build-hero-boat.sh",
    "asset:boat:qa": "sh tools/blender/build-hero-boat.sh --render"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "@types/three": "0.186.0",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
